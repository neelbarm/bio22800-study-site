# Copy to .env.local for local development. In production set these in Vercel > Project > Settings > Environment Variables.

# Public site settings
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_BRAND_NAME=ShipReady
NEXT_PUBLIC_CONTACT_EMAIL=you@your-domain.com
# Optional booking link (Cal.com or Calendly). Shown on the /thanks page after payment as an optional kickoff call; nothing emails it.
NEXT_PUBLIC_CAL_URL=

# Stripe Payment Links (Stripe Dashboard > Payment Links). Set each link's "after payment" redirect to
# https://your-domain.com/thanks?p=diagnosis (both diagnosis links), ?p=sprint (sprint deposits) or ?p=retainer (retainers).
NEXT_PUBLIC_STRIPE_LINK_DIAGNOSIS=
NEXT_PUBLIC_STRIPE_LINK_DIAGNOSIS_INTRO=
NEXT_PUBLIC_STRIPE_LINK_SPRINT_DEPOSIT=
# How many $199 founding-price spots remain (set to 0 to hide the offer)
NEXT_PUBLIC_INTRO_SPOTS_LEFT=3

# Where leads go. Set at least one of these, or read leads in Vercel logs ([lead] lines).
# Slack/Discord incoming webhook, Zapier, Make or n8n URL
LEADS_WEBHOOK_URL=
# Email via Resend (resend.com). LEADS_FROM_EMAIL must be on a domain you verified in Resend.
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL=

# Private lead inbox at /admin/leads (browser asks for a password; any username works).
# Must be at least 12 characters, or the inbox stays disabled.
# Leads are stored when a private Vercel Blob store is connected to the project (sets BLOB_READ_WRITE_TOKEN automatically).
ADMIN_PASSWORD=

# Shown in the privacy policy and terms (fill in before taking real payments)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_LOCATION=
NEXT_PUBLIC_LEGAL_STATE=
NEXT_PUBLIC_LEGAL_COUNTY=

# Optional shared store for rate limits (Upstash Redis, or Vercel KV from the Vercel Marketplace, which sets these).
# Without it, scan limits are counted per server instance and reset on cold starts.
KV_REST_API_URL=
KV_REST_API_TOKEN=
